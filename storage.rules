rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Production remains locked until case authorization is moved to the
    // default Firestore database or enforced by a trusted backend. Storage
    // Rules can only consult the default database, while this app currently
    // stores its case records in a named Firestore database.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
