{
  "name": "cokitos-lab-demo-legal-crm-omega-1-0",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "vite preview --port=3000 --host=0.0.0.0",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts",
    "dev:emulators": "vite --mode emulators --port=3001 --host=127.0.0.1",
    "dev:staging": "vite --mode staging --port=3002 --host=127.0.0.1",
    "emulators:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-emulators.ps1",
    "emulators:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-emulators.ps1",
    "test:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-emulator-rules.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "re2"
    ]
  }
